{
  "name": "dullgenius-rental-platform",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@supabase/supabase-js": "^2.91.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.13.2",
    "dotenv": "^17.3.1",
    "http-proxy-middleware": "^3.0.5",
    "node-fetch": "^3.3.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "recharts": "^3.8.0",
    "sharp": "^0.34.5",
    "styled-components": "^6.1.19",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "predev": "npm run validate:keys && node scripts/validate_env.mjs --scope=client",
    "dev": "vite",
    "prebuild": "npm run validate:keys && node scripts/validate_env.mjs --scope=client",
    "build": "vite build",
    "preview": "vite preview",
    "pull-schema": "node scripts/pull_schema.js",
    "gen:kiosk-qr": "node scripts/gen_kiosk_qr.mjs",
    "validate:env": "node scripts/validate_env.mjs --scope=client --strict",
    "validate:keys": "node scripts/validate_supabase_refs.mjs",
    "validate:env:kiosk": "node scripts/validate_env.mjs --scope=kiosk --strict",
    "validate:env:all": "node scripts/validate_env.mjs --scope=all --strict",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests netlify/functions scripts/validate_env.mjs scripts/validate_supabase_refs.mjs *.config.mjs vite.config.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@vitejs/plugin-react": "^5.1.3",
    "baseline-browser-mapping": "^2.9.19",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "qrcode": "^1.5.4",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.2.7"
  }
}

# VITE_ 접두 변수는 브라우저 번들에 공개됩니다.
# 비밀번호, 서비스 키, 외부 API secret에는 절대 VITE_를 붙이지 마세요.

# [Supabase - 공개 클라이언트 설정]
# 일반 프런트엔드 개발·빌드에는 아래 두 값만 필요합니다.
# 실제 값은 Git에서 제외된 .env.local에 입력하세요. 이 파일에는 값을 남기지 않습니다.
# Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# [Supabase - 서버/관리 스크립트 전용]
# Netlify Function과 공개 조회 스크립트는 SUPABASE_PUBLISHABLE_KEY만 사용합니다.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# 서버 관리자 키는 sb_secret_ 형식만 사용합니다.
SUPABASE_SERVICE_ROLE_KEY=

# [Kiosk - Netlify Function 전용]
# 일반 프런트엔드 개발·빌드에는 불필요합니다. 아래 항목은 비워둬도 됩니다.
# 운영 값은 Netlify 환경변수에 설정합니다. 범위 선택이 가능하면 Functions만 사용하세요.
# 로컬에서 키오스크 서버를 개발할 때만 별도 개발용 계정을 .env.local에 설정합니다.
# npm run validate:env:kiosk — 키오스크 서버 설정을 명시적으로 검사합니다.
KIOSK_EMAIL=
KIOSK_PASSWORD=
KIOSK_MASTER_KEY=
# 키 회전 중에만 이전 키를 임시 허용합니다. 기기 재등록 후 즉시 제거하세요.
KIOSK_MASTER_KEY_PREVIOUS=

# [NAVER API HUB 이미지 검색 - Netlify Function/Vite 개발 프록시 전용]
# 로컬 검색 기능을 시험할 때만 필요합니다. 일반 빌드에서는 검사하지 않습니다.
# NCP Console -> Application Services -> NAVER API HUB에서 발급
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=

# [BoardGameGeek - Netlify Function/Vite 개발 프록시 전용]
# npm run validate:env:all — 프런트엔드·키오스크·NAVER·BGG 설정을 함께 검사합니다.
BGG_API_TOKEN=

# [Discord Notification - 서버/관리 스크립트 전용]
DISCORD_WEBHOOK_URL=
DISCORD_BOT_NAME=
DISCORD_AVATAR_URL=

# [Schema Pull] - node scripts/pull_schema.js
SUPABASE_ACCESS_TOKEN=

# [Legacy GAS API] Supabase 이전으로 더 이상 사용하지 않음
# VITE_API_BASE_URL=

# [Playwright MCP - 로컬 개발 도구 전용] Chrome 확장(Bridge) 연결 토큰. 앱 코드·Netlify에서는 쓰지 않는다.
# Playwright MCP 확장 설정 화면에서 발급. VITE_ 접두 금지(번들에 박힘).
PLAYWRIGHT_MCP_EXTENSION_TOKEN=
